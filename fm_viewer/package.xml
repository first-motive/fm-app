<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fm_viewer</name>
  <version>0.0.0</version>
  <description>First Motive web viewer panel: a dependency-free browser page (Foxglove WS) with a 3D robot, camera feed, plots, and a recordings browser</description>
  <maintainer email="nish@ubundi.co.za">First Motive</maintainer>
  <license>Apache-2.0</license>

  <!-- The panel is a static page served from this package's share dir; it talks to
       foxglove_bridge over the websocket at runtime, so the bridge is an exec dep. -->
  <exec_depend>foxglove_bridge</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
